/*
  TODO
   - [ ] try to set up #defines for bigger keycodes like BACK, FWD, etc.
   - [x] test all combos
   - [ ] test all macros
   - [ ] config encoder https://zmk.dev/docs/features/encoders
   - [ ] implement leader key https://github.com/urob/zmk-leader-key
   - [ ] implement mod morphs (key overrides) https://zmk.dev/docs/keymaps/behaviors/mod-morph
   - [ ] format everything nicely https://zmk.dev/docs/development/contributing/documentation#formatting-and-linting-your-changes
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LCTRL k1  &ht LALT k2  &ht LGUI k3  &st LSHFT k4
#define HRMR(k1,k2,k3,k4) &st RSHFT k1  &ht RGUI k2  &ht LALT k3  &ht RCTRL k4


/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <145>;
            quick-tap-ms = <220>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
        st: shift_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <105>;
            quick-tap-ms = <220>;
            require-prior-idle-ms = <125>; // TODO try removing this or lowering it
            bindings = <&kp>, <&kp>;
        };
        mt: mod_tap {
            // TODO there's some tuning needed here:  when I do quick layer hold-and-release sequences, it seems like it chooses the tap action over hold
            #binding-cells = <2>;
            tapping-term-ms = <145>;
            quick-tap-ms = <220>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <145>;
            bindings = <&shifted>, <&kp>;
            flavor = "tap-preferred";
        };

        /* mod-morphs begin */
        cma_lprn: comma_left_paren {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LPAR>;
            mods = <(MOD_LCTL)>;
        };
        dot_rprn: dot_right_paren {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp RPAR>;
            mods = <(MOD_LCTL)>;
        };
        // TODO num pad overrides
        /* mod-morphs end */

        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            // TODO I could also try replacing all of the &kp items with the raw values
            vim_write_quit_ls {  sequence = <W Q>; bindings = <&vim_wq>; };
            // TODO ask on the ZMK server about this issue where a single char can't be used if it's the first character in another sequence
            vim_write_ls {       sequence = <W W>; bindings = <&vim_w>; };
//            curly_brace_ins_ls { sequence = <C I>; bindings = <&c_brace_ins>; };
//            parens_ins_ls {      sequence = <P I>; bindings = <&paren_ins>; };
            curly_brace_ins_ls { sequence = <C I>; bindings = <&pair_insert LBRC RBRC>; };
            parens_ins_ls {      sequence = <P I>; bindings = <&pair_insert LPAR RPAR>; };
            bracket_ins_ls { sequence = <B I>; bindings = <&pair_insert LBKT RBKT>; };
            updir {              sequence = <U D>; bindings = <&up_dir>; };
        };



        combos {
            compatible = "zmk,combos";
            combo_fun_layer {
                timeout-ms = <50>;
                key-positions = <30 31>;
                bindings = <&mo 4>;
                layers = <0>;
            };
            combo_sym_layer {
                timeout-ms = <50>;
                key-positions = <33 34>;
                bindings = <&mo 1>;
                layers = <0>;
            };
            /*
            combo_esc {
                timeout-ms = <50>;
                key-positions = <0 1>;
                bindings = <&kp ESC>;
            };
            combo_del {
                timeout-ms = <50>;
                key-positions = <8 9>;
                bindings = <&kp DEL>;
            };
            combo_reset {
                timeout-ms = <50>;
                key-positions = <0 9>;
                layers = <2>;
                bindings = <&sys_reset>;
            };
            combo_boot {
                timeout-ms = <50>;
                key-positions = <5 20>;
                layers = <2>;
                bindings = <&bootloader>;
            };
            */
        };
    };

    // TODO read up on the different fields/options
    macros { // TODO can the presses in macro_press and _release be consolidated in a single item?
        up_dir: up_dir {
            #binding-cells = <0>;
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp DOT &kp DOT &kp FSLH>;
        };
        vim_w: vim_write {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp ESC &kp COLON &kp W &kp ENTER>;
        };
        vim_wq: vim_write_and_quit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp ESC &kp COLON &kp W &kp Q &kp ENTER>;
        };
        c_brace_ins: curly_braces_insert {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>; // TODO work up a parameterized version
        };
        paren_ins: parens_insert {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
        };
//        bracket_ins: bracket_insert {
//            compatible = "zmk,behavior-macro";
//            #binding-cells = <0>;
//            wait-ms = <40>;
//            tap-ms = <40>;
//            bindings = <&kp LBKT &kp LBKT &kp LEFT>; // TODO work up a parameterized version
//        };
        log_out: log_out {
            #binding-cells = <0>;
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press   &kp LGUI>,
                <&macro_press   &kp LCTRL>,
                <&macro_tap     &kp Q>,
                <&macro_release &kp LGUI>,
                <&macro_release &kp LCTRL>;
        };
        scrn2clp: scrn2clp {
            #binding-cells = <0>;
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press   &kp LGUI>,
                <&macro_press   &kp LCTRL>,
                <&macro_press   &kp LSHFT>,
                <&macro_tap     &kp N4>,
                <&macro_release &kp LGUI>,
                <&macro_release &kp LCTRL>,
                <&macro_release &kp LSHFT>;
        };
        scrn2fl: scrn2fl {
            #binding-cells = <0>;
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press   &kp LGUI>,
                <&macro_press   &kp LSHFT>,
                <&macro_tap     &kp N4>,
                <&macro_release &kp LGUI>,
                <&macro_release &kp LSHFT>;
        };

        pair_insert: pair_insert {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_param_1to1>,
                       <&kp MACRO_PLACEHOLDER>,
                       <&macro_param_2to1>,
                       <&kp MACRO_PLACEHOLDER>,
                       <&kp LEFT>; // FIXME this barley works at all...
        };
        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            compatible = "zmk,behavior-macro-one-param";
            bindings =
              <&macro_press &kp LSHFT>,
              <&macro_param_1to1 &macro_tap &kp MACRO_PLACEHOLDER>,
              <&macro_release &kp LSHFT>;
        };
        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
              <&macro_press>,
              <&macro_param_1to1>,
              <&macro_param_1to2>,
              <&as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
              <&macro_pause_for_release>,
              <&macro_release>,
              <&macro_param_1to1>,
              <&macro_param_1to2>,
              <&as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        /*
          Layers
          0:  Base
          1:  Symbol/Media // in QMK NRM is in this position
          2:  Number
          3:  Navigation
          4:  Function
          5:  Mouse
          6:  Additional
         */
        base {
            display-name = "Base";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮                      ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  F       │  P       │  B       │                      │  J       │  L       │  U       │  Y       │ ' "      │
            &kp Q      &kp W      &kp E      &kp R      &kp T                             &kp Y      &kp U      &kp I      &kp O      &kp P
        //├──────────┼──────────┼──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  R       │  S       │  T       │  G       │                      │  M       │  N       │  E       │  I       │ O        │
            HRML(A,     S,         D,         F)        &kp G                             &kp H      HRMR(J,     K,         L,        SQT)
        //├──────────┼──────────┼──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Z       │  X       │  C       │  D       │  V       │                      │  K       │  H       │ , <      │ . >      │ / ?      │
        &ht LC(LA(LG(LSHFT))) Z  &kp X &kp C &kp V &ht LC(LA(LSHFT)) B                  &ht LC(LA(LSHFT)) N &kp M &cma_lprn &dot_rprn &ht LC(LA(LG(LSHFT))) FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                            &lt 5 TAB  &lt 2 BSPC        &kp C_MUTE      &lt 3 SPACE &lt 5 DEL
        //                                 ╰──────────┴──────────╯                      ╰──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        med { // 1
            display-name = "Media";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮                      ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │                      │          │          │          │          │          │
            &none      &none      &none      &none      &none                             &none      &none      &none      &none      &none
        //├──────────┼──────────┼──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │                      │          │          │          │          │          │
           &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &none                             &none      &none      &none      &none      &none
        //├──────────┼──────────┼──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │                      │          │          │          │          │          │
            &none      &none      &none      &none      &none                             &none      &none      &none      &none      &none
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                            &kp C_MUTE &kp C_PP          &kp C_PP         &none      &none
        //                                 ╰──────────┴──────────╯                      ╰──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };

        num { // 2
            display-name = "Number";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮      ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │      │          │          │          │          │          │
            &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V) &kp LS(LG(Z))      &kp LBKT   &kp N7      &kp N8      &kp N9      &kp RBKT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT &caps_word         &kp EQUAL  &kp N4     &kp N5     &kp N6      &kp SEMI
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &kp ESC    &none      &leader      &none      &none             &kp BSLH     &kp N1      &kp N2      &kp N3     &kp GRAVE
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &kp BSPC    &trans   &trans  &kp MINUS   &kp N0
        //                                 ╰──────────┴──────────╯      ╰──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav { // 3 // TODO
            display-name = "Navigation";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮      ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │      │          │          │          │          │          │
      &kp LS(LG(LBKT)) &kp LG(LBKT) &kp LG(RBKT) &kp LS(LG(RBKT)) &up_dir &kp LS(LG(Z)) &kp LG(V) &kp LG(C) &kp LG(X)  &kp LG(Z)
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT  &none              &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp SEMI
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &none      &none      &none      &none      &none              &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &kp RETURN
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &none      &none     &trans  &none      &none
        //                                 ╰──────────┴──────────╯      ╰──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fun { // 4 // TODO
            display-name = "Function";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮      ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │      │          │          │          │          │          │
            &log_out   &none      &scrn2clp  &scrn2fl   &none              &none      &kp F7     &kp F8     &kp F9     &kp F12
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT &kp C_BRI_UP          &none      &kp F4     &kp F5     &kp F6     &kp F11
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &none      &none      &none      &none     &kp C_BRI_DN          &none      &kp F1     &kp F2     &kp F3     &kp F10
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &none      &mo 5     &trans  &mo 6      &none
        //                                 ╰──────────┴──────────╯      ╰──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        mse { // 5 // TODO
            display-name = "Mouse Keys";
            // TODO read this first:  https://zmk.dev/docs/keymaps/behaviors/mouse-emulation
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮      ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │      │          │          │          │          │          │
           &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LS(LG(Z))      &none      &none      &none      &none      &none
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &none      &none      &none      &none      &none              &none      &none      &none      &none      &none
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &kp ESC    &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT             &none      &none      &none      &none      &none
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &none      &none     &trans  &none      &none
        //                                 ╰──────────┴──────────╯      ╰──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        add { // 6 // TODO
            display-name = "Additional Features";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮      ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │      │          │          │          │          │          │
          &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none        &kp LS(LG(Z)) &kp LG(V) &kp LG(C) &kp LG(X)  &kp LG(Z)
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &none      &none      &none      &none      &none              &none      &none      &none      &none      &none
        //├──────────┼──────────┼──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │      │          │          │          │          │          │
            &none      &none      &none      &none      &bootloader       &none      &none      &none      &none      &none
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤      ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans    &trans  &trans     &trans
        //                                 ╰──────────┴──────────╯      ╰──────────┴──────────╯
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

    };

};
